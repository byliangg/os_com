export FSTYP=ext4

# TEST_DEV and SCRATCH_DEV are set by run_xfstests.sh from
# /dev/disk/by-id/virtio-vxfstest and virtio-vxfsscratch.

export TEST_DIR=/opt/xfstests/test
export SCRATCH_MNT=/opt/xfstests/scratch

export MOUNT_OPTIONS="-o noacl"
export EXT_MOUNT_OPTIONS="-o noacl"

export FSTYP_HAS_NON_DEFAULT_OPTS=0
export SELINUX_MOUNT_OPTIONS=" "

# The ext4 feature set the kernel supports today (P5): journal + extents on
# 4KiB blocks. The P6 features (dir_index, 64bit, flex_bg, metadata_csum) and
# the unsupported bits (inline_data, uninit_bg/GDT_CSUM) stay off, matching
# the kernel's INCOMPAT_SUPP/RO_COMPAT_SUPP masks (an unknown ro_compat bit
# refuses to mount writable).
export MKFS_OPTIONS="-F -b 4096 -I 256 -O has_journal,extent,filetype,^metadata_csum,^dir_index,^64bit,^flex_bg,^inline_data,^resize_inode,^uninit_bg"
